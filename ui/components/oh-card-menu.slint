import {
    MaterialPalette,
} from "../material-1.0/ui/styling/material_palette.slint";
import { IconButton } from "../material-1.0/material.slint";
import { OhFeatureCard, FeatureCard } from "oh-feature-card.slint";

export component OhCardMenu {
    in property <[FeatureCard]> features;

    callback feature-selected(int);

    property <int> current_index: 0;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 32px;

        swipe := SwipeGestureHandler {
            vertical_stretch: 1;
            width: 100%;

            handle-swipe-left: root.current_index < root.features.length - 1;
            handle-swipe-right: root.current_index > 0;

            swiped => {
                if (self.current-position.x > self.pressed-position.x + self.width / 4) {
                    root.go_prev();
                } else if (self.current-position.x < self.pressed-position.x - self.width / 4) {
                    root.go_next();
                }
            }

            viewport := Rectangle {
                width: 100%;
                height: 100%;
                clip: true;

                track := Rectangle {
                    property <length> page-x: -root.current_index * viewport.width;
                    animate page-x { duration: 200ms; easing: ease-in-out; }

                    property <length> swipe-offset: 0px;
                    x: self.page-x + self.swipe-offset;
                    y: 0px;
                    width: pages.preferred-width;
                    height: viewport.height;

                    states [
                        swiping when swipe.swiping : {
                            swipe-offset: (swipe.current-position.x - swipe.pressed-position.x).clamp(-viewport.width, viewport.width);
                            out {
                                animate swipe-offset { duration: 200ms; easing: ease-in-out; }
                            }
                        }
                    ]

                    pages := HorizontalLayout {
                        for feature[idx] in root.features : OhFeatureCard {
                            width: viewport.width;
                            height: viewport.height;
                            title: feature.title;
                            description: feature.description;
                            status: feature.status;
                            status_kind: feature.status_kind;
                            clicked => { root.feature-selected(idx); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 40px;
            alignment: center;
            cross-axis-alignment: center;
            spacing: 8px;

            IconButton {
                icon: @image-url("../../icons/arrow-left.svg");
                tooltip: "Previous feature";
                clicked => { root.go_prev(); }
            }

            for feature[idx] in root.features : Rectangle {
                width: idx == root.current_index ? 10px : 8px;
                height: idx == root.current_index ? 10px : 8px;
                border-radius: idx == root.current_index ? 5px : 4px;
                background: idx == root.current_index ? MaterialPalette.primary : MaterialPalette.outline_variant;
            }

            IconButton {
                icon: @image-url("../../icons/arrow-right.svg");
                tooltip: "Next feature";
                clicked => { root.go_next(); }
            }
        }
    }

    function go_to(index: int) {
        root.current_index = min(max(index, 0), root.features.length - 1);
    }

    function go_next() {
        root.go_to(root.current_index + 1);
    }

    function go_prev() {
        root.go_to(root.current_index - 1);
    }
}
