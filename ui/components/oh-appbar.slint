import { MaterialText } from "@material";
import {
    MaterialPalette,
} from "../material-1.0/ui/styling/material_palette.slint";
import {
    MaterialTypography,
} from "../material-1.0/ui/styling/material_typography.slint";

export component OhAppBar {

    property <length> appbarHeight: 36px;
    in property <string> statusText: "ETH0: 192.168.88.100 (PoE ACTIVE)";
    in property <bool> linkActive: true;

    Rectangle {
        width: parent.width;
        height: root.appbarHeight;
        background: MaterialPalette.surface_variant;

        HorizontalLayout {
            height: 100%;
            padding-left: 12px;
            padding-right: 12px;
            alignment: space-between;
            cross-axis-alignment: center;

            HorizontalLayout {
                height: 100%;
                spacing: 6px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.linkActive ? MaterialPalette.primary : MaterialPalette.error;
                }

                MaterialText {
                    text: root.statusText;
                    font-size: MaterialTypography.body_small.font-size;
                    vertical-alignment: center;
                    height: 100%;
                }
            }

            MaterialText {
                text: "OhBoyScan";
                font-size: MaterialTypography.label_medium.font-size;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }
}
