import { IconButton, ScrollView } from "../material-1.0/material.slint";
import { MaterialText } from "@material";
import {
    MaterialPalette,
} from "../material-1.0/ui/styling/material_palette.slint";
import {
    MaterialTypography,
} from "../material-1.0/ui/styling/material_typography.slint";
import { FeatureStatus } from "oh-feature-card.slint";

export struct PortResult {
    name: string,
    port: int,
    state: string,
    kind: FeatureStatus,
}

export component OhExposureView {
    in property <string> status;
    in property <[PortResult]> results;
    callback back-requested();

    VerticalLayout {
        width: 100%;
        height: 100%;

        Rectangle {
            width: 100%;
            height: 48px;
            background: MaterialPalette.surface_variant;

            HorizontalLayout {
                height: 100%;
                padding-left: 8px;
                padding-right: 12px;
                alignment: start;
                cross-axis-alignment: center;
                spacing: 4px;

                IconButton {
                    icon: @image-url("../../icons/arrow-left.svg");
                    tooltip: "Back to main";
                    clicked => { root.back-requested(); }
                }

                MaterialText {
                    text: "Exposure Checker";
                    style: MaterialTypography.title_medium;
                    vertical-alignment: center;
                    height: 100%;
                }
            }
        }

        ScrollView {
            width: 100%;

            VerticalLayout {
                width: 100%;
                padding: 12px;
                padding-bottom: 32px;
                spacing: 8px;

                MaterialText {
                    text: root.status;
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.on_surface_variant;
                }

                for result[idx] in root.results : Rectangle {
                    width: 100%;
                    height: 34px;
                    background: MaterialPalette.surface_container;
                    border-radius: 8px;

                    HorizontalLayout {
                        height: 100%;
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;
                        cross-axis-alignment: center;

                        MaterialText {
                            text: result.name;
                            style: MaterialTypography.label_medium;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            MaterialText {
                                text: "\{result.port}";
                                style: MaterialTypography.label_medium;
                                color: MaterialPalette.on_surface_variant;
                                vertical-alignment: center;
                            }

                            MaterialText {
                                text: result.state;
                                style: MaterialTypography.label_medium;
                                color: result.kind == FeatureStatus.ok ? MaterialPalette.primary
                                    : result.kind == FeatureStatus.error ? MaterialPalette.error
                                    : result.kind == FeatureStatus.warn ? MaterialPalette.tertiary
                                    : MaterialPalette.on_surface_variant;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
