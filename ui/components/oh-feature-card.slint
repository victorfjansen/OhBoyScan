import { MaterialText, OutlinedCard } from "@material";
import {
    MaterialPalette,
} from "../material-1.0/ui/styling/material_palette.slint";
import {
    MaterialTypography,
} from "../material-1.0/ui/styling/material_typography.slint";

export enum FeatureStatus {
    neutral,
    ok,
    warn,
    error,
}

export struct FeatureCard {
    title: string,
    description: string,
    status: string,
    status_kind: FeatureStatus,
}

export component OhFeatureCard {
    in property <string> title;
    in property <string> description;
    in property <string> status;
    in property <FeatureStatus> status_kind: FeatureStatus.neutral;

    callback clicked();

    property <color> badge-bg: root.status_kind == FeatureStatus.ok ? MaterialPalette.primary_container
        : root.status_kind == FeatureStatus.warn ? MaterialPalette.tertiary_container
        : root.status_kind == FeatureStatus.error ? MaterialPalette.error_container
        : MaterialPalette.surface_container_highest;

    property <color> badge-fg: root.status_kind == FeatureStatus.ok ? MaterialPalette.on_primary_container
        : root.status_kind == FeatureStatus.warn ? MaterialPalette.on_tertiary_container
        : root.status_kind == FeatureStatus.error ? MaterialPalette.on_error_container
        : MaterialPalette.on_surface_variant;

    OutlinedCard {
        width: 100%;
        height: 100%;
        clickable: true;

        clicked => { root.clicked(); }

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;
                cross-axis-alignment: center;

                MaterialText {
                    text: root.title;
                    style: MaterialTypography.title_medium;
                    vertical-alignment: center;
                }

                badge := Rectangle {
                    border-radius: 8px;
                    background: root.badge-bg;
                    height: 26px;
                    width: max(24px, badge-text.width + 20px);

                    badge-text := MaterialText {
                        x: 10px;
                        text: root.status;
                        style: MaterialTypography.label_medium;
                        color: root.badge-fg;
                        height: 26px;
                        vertical-alignment: center;
                    }
                }
            }

            MaterialText {
                text: root.description;
                style: MaterialTypography.body_small;
                color: MaterialPalette.on_surface_variant;
                wrap: word-wrap;
            }
        }
    }
}
